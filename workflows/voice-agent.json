    {
      "name": "Call Fields",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n \"type\": \"object\",\n \"properties\": {\n  \"outcome\": {\n   \"type\": \"string\",\n   \"enum\": [\n    \"changed_booking\",\n    \"info_only\",\n    \"callback_needed\",\n    \"complaint\",\n    \"spam_or_wrong_number\"\n   ]\n  },\n  \"follow_up\": {\n   \"type\": \"boolean\"\n  },\n  \"follow_up_reason\": {\n   \"type\": [\n    \"string\",\n    \"null\"\n   ]\n  },\n  \"summary\": {\n   \"type\": \"string\"\n  }\n },\n \"required\": [\n  \"outcome\",\n  \"follow_up\",\n  \"follow_up_reason\",\n  \"summary\"\n ]\n}"
      },
      "id": "94c2b419-8de6-910a-079e-80f671307f08",
      "position": [
        1940,
        760
      ]
    },
    {
      "name": "Decide",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst f = $('Call Facts').first().json; const caller = $('Report Caller').first().json; const o = $json.output;\nconst ok = !$json.error && o && [\"changed_booking\",\"info_only\",\"callback_needed\",\"complaint\",\"spam_or_wrong_number\"].includes(o.outcome) && typeof o.follow_up === 'boolean';\nlet outcome = 'unclassified', follow_up = true, reason = $json.error ? 'ai_unavailable' : 'ai_output_unusable', summary = '';\nif (ok) {\n  outcome = o.outcome; summary = String(o.summary || '').slice(0, 500);\n  // A complaint or a call that needs a person always gets one, whatever the model said about follow-up.\n  follow_up = o.follow_up || outcome === 'complaint' || outcome === 'callback_needed';\n  reason = follow_up ? String(o.follow_up_reason || outcome).slice(0, 300) : '';\n}\nif (/error|fault|failed/i.test(f.ended_reason) && outcome !== 'spam_or_wrong_number' && !follow_up) { follow_up = true; reason = 'the call ended on a system error (' + f.ended_reason + ')'; }\nreturn [{ json: { ...f, customer_email: caller.customer_email || '', outcome, follow_up, reason, summary, ai_status: ok ? 'ok' : reason } }];"
      },
      "id": "e77e85ff-2b4f-9da2-0858-4cc002777b82",
      "position": [
        2080,
        500
      ]
    },

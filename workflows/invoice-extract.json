    {
      "name": "Text Check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst v = $('Validate').first().json;\nconst text = String($json.text || '').replace(/[ \\t]+/g, ' ').trim();\nlet reason = '';\nif ($json.error) reason = 'unreadable_pdf';\nelse if (($json.numpages || 0) > 5) reason = 'too_many_pages';\nelse if (text.length < 40) reason = 'no_text_layer';\nelse if (text.length > 15000) reason = 'document_too_long';\nreturn { json: { readable: !reason, reason, text, file_name: v.file_name, dry_run: v.dry_run } };"
      },
      "id": "6d2b4236-46cf-3055-2fca-86b5c7b5fdb9",
      "position": [
        1040,
        300
      ]
    },

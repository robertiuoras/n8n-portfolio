        "mode": "runOnceForEachItem",
        "jsCode": "\n// No AI call: there is nothing to read. In production an OCR step would go here; until then a person types it in.\nreturn { json: { route: 'needs_review', reasons: [$json.reason], invoice: null, invoice_key: '', file_name: $json.file_name, dry_run: $json.dry_run, text: $json.text } };"

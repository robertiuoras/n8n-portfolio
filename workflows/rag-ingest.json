    {
      "name": "Chunk",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst { doc_id, title, text } = $('Validate').first().json;\nconst MAX = 1500; // characters per chunk; a longer section is split between paragraphs\nconst sections = []; let cur = { section: 'Introduction', lines: [] };\nfor (const line of text.split('\\n')) {\n  const m = line.match(/^##\\s+(.*)/);\n  if (m) { if (cur.lines.join('').trim()) sections.push(cur); cur = { section: m[1].trim(), lines: [] }; }\n  else if (!/^#\\s/.test(line)) cur.lines.push(line);\n}\nif (cur.lines.join('').trim()) sections.push(cur);\nconst chunks = [];\nfor (const s of sections) {\n  let buf = '';\n  // Gemini silently cuts off long input instead of failing, so a paragraph longer than MAX is split by sentence.\n  const pieces = s.lines.join('\\n').split(/\\n\\s*\\n/).map((x) => x.trim()).filter(Boolean)\n    .flatMap((p) => p.length <= MAX ? [p] : (p.match(/[^.!?]+[.!?]*\\s*/g) || [p]).flatMap((x) => x.match(new RegExp('[\\\\s\\\\S]{1,' + MAX + '}', 'g'))));\n  for (const p of pieces) {\n    if (buf && buf.length + p.length > MAX) { chunks.push({ section: s.section, body: buf }); buf = ''; }\n    buf += (buf ? '\\n\\n' : '') + p;\n  }\n  if (buf) chunks.push({ section: s.section, body: buf });\n}\nreturn chunks.map((c, i) => ({ json: { chunk_id: doc_id + '#' + (i + 1), doc_id, title, section: c.section, text: title + ' > ' + c.section + '\\n' + c.body } }));"
      },
      "id": "5c2eebf0-2ed8-d67c-5af2-ad3a4421ce6a",
      "position": [
        780,
        300
      ]
    },
    {
      "name": "Embed Chunk",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "onError": "continueRegularOutput",
      "credentials": {
        "googlePalmApi": {
          "id": "__GEMINI_CRED_ID__",
          "name": "Gemini free tier"
        }
      },
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-embedding-2:embedContent",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googlePalmApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ content: { parts: [{ text: $json.text }] }, taskType: 'RETRIEVAL_DOCUMENT', title: $json.title, outputDimensionality: 768 }) }}",
        "options": {
          "timeout": 30000,
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 700
            }
          },
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "id": "85e08a35-a1f6-8866-10b4-3fd3d5691f21",
      "position": [
        1040,
        300
      ]
    },
    {
      "name": "Check Embeddings",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst chunks = $('Chunk').all().map((i) => i.json);\nconst res = $input.all().map((i) => i.json);\nconst failed = [], rows = [], at = new Date().toISOString();\nchunks.forEach((c, i) => {\n  const r = res[i] || {}; const v = r.body && r.body.embedding && r.body.embedding.values;\n  if (r.statusCode !== 200 || !Array.isArray(v) || v.length !== 768) {\n    failed.push({ chunk_id: c.chunk_id, status: r.statusCode ?? null, error: r.error ? (r.error.message || String(r.error)) : JSON.stringify(r.body || '').slice(0, 200) });\n    return;\n  }\n  rows.push({ ...c, embedding: JSON.stringify(v.map((x) => Math.round(x * 1e6) / 1e6)), model: 'gemini-embedding-2', ingested_at: at });\n});\nreturn [{ json: { ok: failed.length === 0 && rows.length > 0, doc_id: chunks[0].doc_id, chunks: chunks.length, failed, rows } }];"
      },
      "id": "c9259650-7f8e-a870-7df6-52a5b33f0410",

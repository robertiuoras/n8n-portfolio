    {
      "name": "Validate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst b = $json.body || {}; const errs = [];\nif (typeof b.doc_id !== 'string' || !/^[a-z0-9-]{2,60}$/.test(b.doc_id)) errs.push('doc_id is required: 2-60 lowercase letters, digits or dashes');\nif (typeof b.title !== 'string' || !b.title.trim()) errs.push('title is required');\nif (typeof b.text !== 'string' || b.text.trim().length < 20) errs.push('text is required (the document in markdown)');\nelse if (b.text.length > 100000) errs.push('text must be 100,000 characters or fewer');\nreturn { json: { valid: errs.length === 0, errors: errs, doc_id: b.doc_id, title: (b.title || '').trim(), text: b.text } };"
      },
      "id": "173be761-97cb-9ba7-29ba-dd9b16baf8fa",

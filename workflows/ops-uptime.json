          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        },
        "options": {}
      },
      "id": "e7f1a1d7-6014-e711-49a3-42d81a4dd70a",
      "position": [
        1820,
        160
      ]
    },
    {
      "name": "Close Alert",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "parameters": {
        "resource": "row",
        "operation": "update",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "ops_alerts"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "alert_id",
              "condition": "eq",
              "keyValue": "={{ $json.alert_id }}"

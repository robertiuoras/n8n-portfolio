    {
      "name": "Embed Question",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "onError": "continueRegularOutput",
      "credentials": {
        "googlePalmApi": {
          "id": "__GEMINI_CRED_ID__",
          "name": "Gemini free tier"
        }
      },
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-embedding-2:embedContent",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googlePalmApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ content: { parts: [{ text: $json.question }] }, taskType: 'RETRIEVAL_QUERY', outputDimensionality: 768 }) }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "id": "88904d75-5052-5886-bcab-1498b3186042",
      "position": [
        780,
        300
      ]
    },
    {
      "name": "Load Chunks",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "alwaysOutputData": true,
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "rag_chunks"
        },
        "returnAll": true
      },
      "id": "cd22f48b-acc5-ac0d-387b-1d347f19e0d5",
      "position": [
        1040,
        300
      ]
    },
    {
      "name": "Retrieve",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst question = $('Validate').first().json.question;\nconst e = $('Embed Question').first().json;\nconst qv = e.body && e.body.embedding && e.body.embedding.values;\nconst none = (reason) => [{ json: { ok: false, reason, question, top: [], top_score: 0 } }];\nif (e.statusCode !== 200 || !Array.isArray(qv)) return none('retrieval_unavailable');\nconst rows = $input.all().map((i) => i.json).filter((r) => r.chunk_id && r.embedding);\nif (!rows.length) return none('no_documents');\nconst dot = (a, b) => { let s = 0; for (let i = 0; i < a.length; i++) s += a[i] * b[i]; return s; };\nconst qn = Math.sqrt(dot(qv, qv));\nconst top = rows.map((r) => { const v = JSON.parse(r.embedding); return { chunk_id: r.chunk_id, doc_id: r.doc_id, title: r.title, section: r.section, text: r.text, score: dot(qv, v) / (qn * Math.sqrt(dot(v, v))) }; })\n  .sort((a, b) => b.score - a.score).slice(0, 4);\nconst top_score = Math.round(top[0].score * 1000) / 1000;\nconst slim = top.map(({ text, ...c }) => ({ ...c, score: Math.round(c.score * 1000) / 1000 }));\nif (top_score < 0.6) return [{ json: { ok: false, reason: 'nothing_relevant', question, top: slim, top_score } }];\nreturn [{ json: { ok: true, reason: '', question, top: slim, top_score, context: top.map((c) => '[' + c.chunk_id + '] ' + c.text).join('\\n\\n') } }];"
      },
      "id": "94b98802-9cb4-2ac0-b549-8bbde39bc0db",
      "position": [
        1300,
        300
      ]
    },

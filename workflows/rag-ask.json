    {
      "name": "Validate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst q = ($json.body || {}).question;\nconst errs = [];\nif (!q || typeof q !== 'string' || q.trim().length < 3) errs.push('question is required');\nelse if (q.length > 500) errs.push('question must be 500 characters or fewer');\nreturn { json: { valid: errs.length === 0, errors: errs, question: typeof q === 'string' ? q.trim() : '' } };"
      },
      "id": "faa31c88-b043-50f2-883e-bd7c715eb2fc",
      "position": [
        260,
        300
      ]
    },
    {
      "name": "Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "236392a5-44d5-34b5-993b-5068f8f1d35d",
              "leftValue": "={{ $json.valid }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },

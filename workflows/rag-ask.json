    {
      "name": "Answer From Docs",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "parameters": {
        "promptType": "define",
        "text": "=Customer question: {{ $json.question }}\n\nDocument extracts:\n{{ $json.context }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "You are the support assistant for Acme Solar, a fictional home-solar installer. Answer ONLY from the document extracts in the user message. Each extract starts with its id in square brackets, for example [price-sheet#2]. If the extracts do not clearly contain the answer, set supported=false, confidence low, and leave cited_chunk_ids empty. Do not guess and do not use outside knowledge, even when the question is close to something the extracts cover. When supported, answer in one to three plain sentences, include the exact figures from the extracts, and list the ids of the extracts you used in cited_chunk_ids. confidence is 0 to 1."
            }
          ]
        }
      },
      "id": "1fed98fe-6437-4118-f99c-05c64ac3861d",
      "position": [
        1820,
        220
      ]
    },
    {
      "name": "Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "parameters": {
        "modelName": "models/gemini-3.5-flash-lite",
        "options": {
          "temperature": 0
        }
      },
      "credentials": {
        "googlePalmApi": {
          "id": "__GEMINI_CRED_ID__",
          "name": "Gemini free tier"
        }
      },
      "id": "a090b74f-d4fa-fc37-598c-24cd9e385022",
      "position": [
        1780,
        480
      ]
    },
    {
      "name": "Answer Fields",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n \"type\": \"object\",\n \"properties\": {\n  \"answer\": {\n   \"type\": \"string\"\n  },\n  \"supported\": {\n   \"type\": \"boolean\"\n  },\n  \"confidence\": {\n   \"type\": \"number\",\n   \"minimum\": 0,\n   \"maximum\": 1\n  },\n  \"cited_chunk_ids\": {\n   \"type\": \"array\",\n   \"items\": {\n    \"type\": \"string\"\n   }\n  }\n },\n \"required\": [\n  \"answer\",\n  \"supported\",\n  \"confidence\",\n  \"cited_chunk_ids\"\n ]\n}"
      },
      "id": "2d10f06d-6cde-3711-ea4e-4db1158fd0d8",
      "position": [
        1940,
        480
      ]
    },
    {
      "name": "Decide",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst r = $('Retrieve').first().json;\nlet reason = r.reason || '', o = null;\nif (r.ok) {\n  o = $json.output;\n  const shape = o && typeof o === 'object' && typeof o.answer === 'string' && typeof o.supported === 'boolean' && typeof o.confidence === 'number' && Array.isArray(o.cited_chunk_ids);\n  const retrieved = r.top.map((c) => c.chunk_id);\n  if ($json.error) reason = 'ai_unavailable';\n  else if (!shape) reason = 'ai_output_unusable';\n  else if (!o.supported) reason = 'not_in_docs';\n  else if (o.confidence < 0.6) reason = 'low_confidence';\n  else if (o.cited_chunk_ids.length === 0 || !o.cited_chunk_ids.every((id) => retrieved.includes(id))) reason = 'citation_not_retrieved';\n}\nconst answered = reason === '';\nreturn { json: { answered, reason: answered ? 'answered' : reason, question: r.question,\n  answer: answered ? o.answer : \"I can't answer that reliably from our documents. I've passed your question to our team and they will reply by email.\",\n  confidence: o && typeof o.confidence === 'number' ? o.confidence : 0,\n  citations: answered ? r.top.filter((c) => o.cited_chunk_ids.includes(c.chunk_id)).map((c) => ({ chunk_id: c.chunk_id, title: c.title, section: c.section })) : [],\n  retrieved: r.top.map((c) => ({ chunk_id: c.chunk_id, doc_id: c.doc_id, score: c.score })), top_score: r.top_score } };"
      },
      "id": "987cd88a-ab00-51a5-4f56-8f612839c73f",
      "position": [
        2080,
        300
      ]
    },

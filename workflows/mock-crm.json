    {
      "name": "Decide",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst req = $('POST Contact').first().json;\nconst b = req.body || {};\nconst fail = String(req.headers['x-fail'] || '').toLowerCase();\nconst prior = $input.all().filter(i => i.json.id !== undefined && i.json.id !== null).length;\nlet mode = 'ok', message = '';\nif (!b.email || typeof b.email !== 'string') { mode = 'bad_request'; message = 'email is required'; }\nelse if (fail === '500') mode = '500';\nelse if (fail === '429') mode = '429';\nelse if (fail === '400') mode = '400';\nelse if (fail === 'timeout') mode = 'timeout';\nelse if (fail === '500x2') mode = prior < 2 ? '500x2_fail' : 'ok';\nreturn [{ json: { mode, message, prior_500x2_failures: prior, x_fail: fail, email: (b.email || '').toLowerCase(), contact: b } }];"
      },
      "id": "9fd517cd-a537-710c-1e24-b790ba419d0f",
      "position": [
        520,
        0
      ]
    },

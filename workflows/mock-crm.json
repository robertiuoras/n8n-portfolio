        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "mock_crm_log"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "email": "={{ $json.email }}",
            "method": "POST",
            "x_fail": "={{ $json.x_fail }}",
            "outcome": "={{ $json.mode === '500x2_fail' ? 'injected_500x2' : ($json.mode === 'ok' ? 'ok' : 'injected_' + $json.mode) }}",
            "at": "={{ $now.toISO() }}"
          },
          "matchingColumns": [],
          "schema": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        },
        "options": {}
      },
      "id": "69f51449-0ab4-5b64-d20b-271beae03789",
      "position": [
        780,
        0
      ]
    },

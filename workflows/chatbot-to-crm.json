    {
      "name": "Validate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst b = $json.body || {};\nconst errs = [];\nif (!b.conversation_id || typeof b.conversation_id !== 'string') errs.push('conversation_id is required');\nif (typeof b.approved !== 'boolean') errs.push('approved must be true or false');\nconst c = b.customer || {};\nif (!c.email || !/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(String(c.email))) errs.push('customer.email is missing or not a valid email');\nif (!c.name) errs.push('customer.name is required');\nif (!b.summary) errs.push('summary is required');\nif (!b.request_type) errs.push('request_type is required');\nreturn { json: { valid: errs.length === 0, errors: errs, approved: b.approved === true, body: b, xfail: String($json.headers['x-fail'] || '') } };"
      },
      "id": "3808cc80-499e-fd22-ca20-2189e20fa5c0",
      "position": [
        260,
        300
      ]
    },
    {
      "name": "Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "236392a5-44d5-34b5-993b-5068f8f1d35d",
              "leftValue": "={{ $json.valid }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "6b415ada-c603-b082-03a3-ccdcbb570446",
      "position": [
        520,
        300
      ]
    },
    {
      "name": "Respond 400",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: 'rejected', reasons: $('Validate').first().json.errors }) }}",
        "options": {
          "responseCode": 400
        }
      },
      "id": "8099aac5-7b97-1f1b-54a4-85d5b815ca72",
      "position": [

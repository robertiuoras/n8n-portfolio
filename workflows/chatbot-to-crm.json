      "name": "Chatbot Summary",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "webhookId": "ab31fa14-8781-9c3d-c85c-e8a511e7f5c7",
      "parameters": {
        "httpMethod": "POST",
        "path": "chatbot-summary",
        "responseMode": "responseNode",
        "options": {}

    {
      "name": "CRM Lookup",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "GET",
        "url": "http://localhost:5678/webhook/mock-crm/contacts",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "email",
              "value": "={{ $('Make Key').first().json.body.customer.email.toLowerCase() }}"
            }
          ]
        },
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "id": "a92e273b-65ea-bfd3-f748-e88c52e991b9",
      "position": [
        1820,
        400
      ]
    },
    {
      "name": "Prepare",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst v = $('Validate').first().json; const b = v.body; const c = b.customer;\nconst exists = $json.statusCode === 200 && $json.body && $json.body.found === true;\nreturn { json: { exists, lookup_status: $json.statusCode ?? null, key: $('Make Key').first().json.key, xfail: v.xfail,\n  payload: { email: c.email.toLowerCase(), name: c.name, phone: c.phone || '', company: c.company || '', summary: b.summary, request_type: b.request_type, conversation_id: b.conversation_id } } };"
      },
      "id": "fb5b8cb1-6d0c-43f7-c569-77c3d5d60c0d",
      "position": [
        2080,
        400
      ]
    },
    {
      "name": "CRM Upsert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "POST",
        "url": "http://localhost:5678/webhook/mock-crm/contacts",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-fail",
              "value": "={{ $('Prepare').first().json.xfail }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($('Prepare').first().json.payload) }}",
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "id": "f438f4a3-3d7e-0d94-85f4-a8a4b7acef9a",
      "position": [
        2340,
        400
      ]
    },
    {
      "name": "Classify Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst attempt = $runIndex + 1;\nconst r = $json;\nconst status = (r.statusCode === undefined) ? null : r.statusCode;\nconst ok = status !== null && status >= 200 && status < 300;\nconst retryable = status === null || status === 429 || status >= 500;\nlet outcome = 'fail';\nif (ok) outcome = 'ok'; else if (retryable && attempt < 3) outcome = 'retry';\nconst err = r.error ? (typeof r.error === 'string' ? r.error : (r.error.message || JSON.stringify(r.error))) : ('HTTP ' + status + ' ' + JSON.stringify(r.body || '').slice(0, 200));\nreturn { json: { outcome, attempt, status, error: ok ? null : err, backoff: Math.pow(2, attempt - 1), crm: ok ? r.body : null, step: 'crm_upsert' } };"
      },
      "id": "f0573125-b1a8-0e0d-6edc-4f160388ccbf",
      "position": [
        2600,
        400
      ]
    },
    {
      "name": "Outcome",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.4,
      "parameters": {
        "mode": "expression",
        "numberOutputs": 3,
        "output": "={{ [\"ok\",\"retry\",\"fail\"].indexOf($json.outcome) }}"
      },
      "id": "86a65918-45fa-5ba0-d4fa-d9d78e643875",
      "position": [

              "id": "f950e591-2707-8e74-956f-e6090ab97c3b",
              "leftValue": "={{ $json.id !== undefined && $json.id !== null }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }

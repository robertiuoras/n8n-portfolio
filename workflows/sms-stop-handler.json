        "url": "={{ $('Config').first().json.sms_api_url }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ to: $('Read Message').first().json.phone, from: $('Config').first().json.sender_id, body: $('Config').first().json.business_name + ': you are opted out and will not get any more texts from us.' }) }}",
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "id": "38c2b147-a1ab-cd6e-58b3-3d4f73cb74dc",

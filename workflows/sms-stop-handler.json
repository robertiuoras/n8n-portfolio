    {
      "name": "Read Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst digits = (v) => String(v || '').replace(/\\D/g, '');\nconst phoneKind = (v) => { const d = digits(v);\n  if (/^04\\d{8}$/.test(d)) return { e164: '+61' + d.slice(1), mobile: true };\n  if (/^614\\d{8}$/.test(d)) return { e164: '+' + d, mobile: true };\n  if (/^0[2378]\\d{8}$/.test(d)) return { e164: '+61' + d.slice(1), mobile: false };\n  if (/^61[2378]\\d{8}$/.test(d)) return { e164: '+' + d, mobile: false };\n  return { e164: '', mobile: false }; };\nconst b = $json.body || {};\nconst from = phoneKind(b.from ?? b.From); const text = String(b.body ?? b.Body ?? '').trim();\nconst errs = [];\nif (!from.e164) errs.push('from must be a phone number');\nif (!text) errs.push('body is required');\nconst m = text.match(/^\\s*(STOP|STOPALL|UNSUBSCRIBE|CANCEL|END|QUIT)[\\s.!]*$/i);\nconst word = m ? m[1].toUpperCase() : '';\nconst isStop = !!m;\nreturn { json: { ok: errs.length === 0, errors: errs, phone: from.e164, text, is_stop: errs.length === 0 && isStop, keyword: word } };"
      },
      "id": "5be7f618-6eda-0ede-95b1-aeac94ad4a63",
      "position": [
        520,
        300
      ]
    },
    {
      "name": "Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "236392a5-44d5-34b5-993b-5068f8f1d35d",
              "leftValue": "={{ $json.ok }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "7a7adb48-a874-0069-2dd1-448dd52ca8bc",
      "position": [
        780,
